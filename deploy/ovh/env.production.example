# Production — copy to /opt/fmmt/.env on the VPS (never commit real secrets)

POSTGRES_DB=fmmt
POSTGRES_USER=fmmt
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Pas besoin de POSTGRES_PORT / APP_PORT en prod (compose.prod bind 127.0.0.1:3000)

RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Festival Mondial de la Musique et du Tourisme <noreply@fmmt.events>
RESEND_FROM_NAME=Festival Mondial de la Musique et du Tourisme

ADMIN_EMAIL=info@fmmt.events
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

APP_URL=https://fmmt.events
