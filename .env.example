DATABASE_URL="postgresql://fmmt:fmmt@localhost:5435/fmmt?schema=public"

POSTGRES_DB=fmmt
POSTGRES_USER=fmmt
POSTGRES_PASSWORD=fmmt
POSTGRES_PORT=5435
APP_PORT=3000

RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="Festival Mondial de la Musique et du Tourisme <noreply@fmmt.events>"
RESEND_FROM_NAME="Festival Mondial de la Musique et du Tourisme"

AUTH_SECRET="generate-a-long-random-secret"

# Compte super admin créé au seed (docker migrate / npm run db:seed)
ADMIN_EMAIL="info@fmmt.events"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Super Admin"
# ADMIN_PASSWORD_RESET=true  # force le reset du hash au prochain seed

APP_URL="https://fmmt.events"

# Cloudflare Turnstile — ignored locally (NODE_ENV=development or TURNSTILE_ENABLED=false)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ENABLED=false
